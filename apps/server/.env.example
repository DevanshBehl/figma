# Copy to .env and fill in your values

# PostgreSQL connection string
# Local:   postgresql://postgres:password@localhost:5432/aether
# Docker:  postgresql://postgres:postgres@localhost:5432/aether
DATABASE_URL="postgresql://postgres:password@localhost:5432/aether"

# Server port (default 3001)
PORT=3001

# Allowed CORS origin (Next.js dev server)
CLIENT_ORIGIN="http://localhost:3000"
